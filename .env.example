NODE_ENV="development"
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres?schema=public"
FRONTEND_URL="http://localhost:3000"
PORT=3001
TRUST_PROXY_HOPS=0

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

OTP_PROVIDER="fake"
OTP_FAKE_CODE="123456"
OTP_PENDING_REGISTRATION_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_PHONE_SEND_LIMIT=5
OTP_IP_SEND_LIMIT=20

TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_AUTH_TOKEN="replace-with-your-twilio-auth-token"

TWILIO_PHONE_NUMBER="+10000000000"
TWIML_BIN_URL="https://handler.twilio.com/twiml/EH00000000000000000000000000000000"

FIREBASE_PROJECT_ID="replace-with-your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-your-firebase-client-email"
FIREBASE_PRIVATE_KEY="replace-with-your-firebase-private-key"
