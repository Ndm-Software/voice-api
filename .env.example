DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres?schema=public"
FRONTEND_URL="http://localhost:3000"
PORT=3001

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_HOST=localhost
REDIS_PORT=6379

FIREBASE_PROJECT_ID=buraya_project_id
FIREBASE_CLIENT_EMAIL=buraya_client_email
FIREBASE_PRIVATE_KEY="buraya_private_key"