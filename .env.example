NODE_ENV="development"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-local-postgres-password"
POSTGRES_DB="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:replace-with-a-local-postgres-password@localhost:5432/postgres?schema=public"
FRONTEND_URL="http://localhost:3000"
PORT=3001
TRUST_PROXY_HOPS=0

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

OTP_PROVIDER="fake"
OTP_FAKE_CODE="123456"
OTP_PENDING_REGISTRATION_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_PHONE_SEND_LIMIT=5
OTP_IP_SEND_LIMIT=20

TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_AUTH_TOKEN="replace-with-your-twilio-auth-token"

TWILIO_PHONE_NUMBER="+10000000000"
TWILIO_VOICE_MEDIA_BASE_URL="https://replace-with-your-public-api-host.example/api/voice-call/media"

FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
