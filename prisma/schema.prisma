// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Language {
  languageId String @id @default(uuid()) @map("language_id") @db.Uuid
  code       String @unique
  name       String
  voiceName  String @map("voice_name")

  userSettings UserSetting[]

  @@map("languages")
}

model User {
  userId        String   @id @default(uuid()) @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String   @unique
  phoneNumber   String   @unique @map("phone_number")
  passwordHash  String   @map("password_hash")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userSetting      UserSetting?
  devices          Device[]
  otpVerifications OtpVerification[]
  reminders        Reminder[]
  silentHours      SilentHour[]

  @@map("users")
}

model UserSetting {
  settingId  String @id @default(uuid()) @map("setting_id") @db.Uuid
  userId     String @unique @map("user_id") @db.Uuid
  languageId String @map("language_id") @db.Uuid

  timezone             String  @db.VarChar(100)
  province             String  @db.VarChar(100)
  notificationsEnabled Boolean @map("notifications_enabled")
  defaultPushBefore    Int     @map("default_push_before")
  defaultCallBefore    Int     @map("default_call_before")
  emergencyOverride    Boolean @map("emergency_override")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [languageId])

  @@map("user_settings")
}

enum PlatformType {
  WEB
  ANDROID
  IOS
  WINDOWS
}

model Device {
  deviceId       String @id @default(uuid()) @map("device_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  installationId String @map("installation_id") @db.Uuid

  platform      PlatformType
  deviceName    String       @map("device_name") @db.VarChar(100)
  pushToken     String?      @map("push_token") @db.Text
  pushTokenHash String?      @unique @map("push_token_hash") @db.Char(64)
  lastActive    DateTime     @default(now()) @map("last_active")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, installationId])
  @@map("devices")
}

model RefreshToken {
  refreshTokenId String @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  deviceId       String @map("device_id") @db.Uuid

  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpVerification {
  otpId String @id @default(uuid()) @map("otp_id") @db.Uuid

  userId      String @map("user_id") @db.Uuid
  phoneNumber String @map("phone_number") @db.VarChar(20)
  otpCode     String @map("otp_code") @db.VarChar(10)

  purpose OtpPurpose

  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("otp_verifications")
}

enum OtpPurpose {
  PHONE_CHANGE
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model Reminder {
  reminderId       String  @id @default(uuid()) @map("reminder_id") @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  parentReminderId String? @map("parent_reminder_id") @db.Uuid

  title         String         @db.VarChar(255)
  description   String?        @db.Text
  eventDatetime DateTime       @map("event_datetime")
  repeatType    RepeatType     @map("repeat_type")
  repeatUntil   DateTime?      @map("repeat_until")
  status        ReminderStatus
  isUrgent      Boolean        @default(false) @map("is_urgent")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  parentReminder Reminder? @relation("ReminderException", fields: [parentReminderId], references: [reminderId])

  childReminders    Reminder[]                @relation("ReminderException")
  pushNotifications PushNotificationSetting[]
  voiceCallSettings VoiceCallSetting[]
  histories         ReminderHistory[]

  @@map("reminders")
}

enum RepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model ReminderHistory {
  historyId    String        @id @default(uuid()) @map("history_id") @db.Uuid
  reminderId   String        @map("reminder_id") @db.Uuid
  historyType  HistoryType
  status       HistoryStatus
  provider     String?       @db.VarChar(50)
  sentAt       DateTime?     @map("sent_at")
  attempt      Int           @default(0)
  errorMessage String?       @map("error_message") @db.Text

  reminder Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("reminder_history")
}

enum HistoryType {
  PUSH
  VOICE_CALL
}

enum HistoryStatus {
  SUCCESS
  FAILED
  PENDING
}

model PushNotificationSetting {
  pushId        String @id @default(uuid()) @map("push_id") @db.Uuid
  reminderId    String @map("reminder_id") @db.Uuid
  minutesBefore Int    @map("minutes_before")

  jobId   String  @map("job_id") @db.VarChar(100)
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("push_notification_settings")
}

model VoiceCallSetting {
  callId        String @id @default(uuid()) @map("call_id") @db.Uuid
  reminderId    String @map("reminder_id") @db.Uuid
  minutesBefore Int    @map("minutes_before")

  retryCount Int     @default(0) @map("retry_count")
  jobId      String? @map("job_id") @db.VarChar(100)
  enabled    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("voice_call_settings")
}

model SilentHour {
  silentHourId String @id @default(uuid()) @map("silent_hour_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  dayOfWeek   DayOfWeek @map("day_of_week")
  silentStart DateTime  @map("silent_start") @db.Time
  silentEnd   DateTime  @map("silent_end") @db.Time

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("silent_hours")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
