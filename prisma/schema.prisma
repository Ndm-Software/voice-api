// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Language {
  languageId Int    @id @default(autoincrement()) @map("language_id")
  code       String @unique
  name       String
  voiceName  String @map("voice_name")

  userSettings UserSetting[]

  @@map("languages")
}

model User {
  userId        Int      @id @default(autoincrement()) @map("user_id")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String   @unique
  phoneNumber   String   @unique @map("phone_number")
  passwordHash  String   @map("password_hash")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userSetting      UserSetting?
  devices          Device[]
  otpVerifications OtpVerification[]
  reminders        Reminder[]

  silentHours SilentHour[]

  @@map("users")
}

model UserSetting {
  settingId  Int @id @default(autoincrement()) @map("setting_id")
  userId     Int @unique @map("user_id")
  languageId Int @map("language_id")

  timezone String @db.VarChar(100)
  province String @db.VarChar(100)

  notificationsEnabled Boolean @map("notifications_enabled")
  defaultPushBefore    Int     @map("default_push_before")
  defaultCallBefore    Int     @map("default_call_before")
  emergencyOverride    Boolean @map("emergency_override")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [userId])
  language Language @relation(fields: [languageId], references: [languageId])

  @@map("user_settings")
}

enum PlatformType {
  WEB
  ANDROID
  IOS
  WINDOWS
}

model Device {
  deviceId       Int    @id @default(autoincrement()) @map("device_id")
  userId         Int    @map("user_id")
  installationId String @map("installation_id") @db.Uuid

  platform      PlatformType
  deviceName    String       @map("device_name") @db.VarChar(100)
  pushToken     String?      @map("push_token") @db.Text
  pushTokenHash String?      @unique @map("push_token_hash") @db.Char(64)
  lastActive    DateTime     @default(now()) @map("last_active")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, installationId])
  @@map("devices")
}

model RefreshToken {
  refreshTokenId Int @id @default(autoincrement()) @map("refresh_token_id")
  deviceId       Int @map("device_id")

  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpVerification {
  otpId Int @id @default(autoincrement()) @map("otp_id")

  userId      Int    @map("user_id")
  phoneNumber String @map("phone_number") @db.VarChar(20)

  otpCode String @map("otp_code") @db.VarChar(10)

  purpose OtpPurpose

  expiresAt DateTime @map("expires_at")

  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("otp_verifications")
}

enum OtpPurpose {
  PHONE_CHANGE
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model Reminder {
  reminderId Int @id @default(autoincrement()) @map("reminder_id")

  userId Int @map("user_id")

  parentReminderId Int? @map("parent_reminder_id")

  title String @db.VarChar(255)

  description String? @db.Text

  eventDatetime DateTime @map("event_datetime")

  repeatType RepeatType @map("repeat_type")

  repeatUntil DateTime? @map("repeat_until")

  status ReminderStatus

  isUrgent Boolean @default(false) @map("is_urgent")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId])

  parentReminder Reminder? @relation("ReminderException", fields: [parentReminderId], references: [reminderId])

  childReminders    Reminder[]                @relation("ReminderException")
  pushNotifications PushNotificationSetting[]
  voiceCallSettings VoiceCallSetting[]
  histories         ReminderHistory[]

  @@map("reminders")
}

enum RepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model ReminderHistory {
  historyId Int @id @default(autoincrement()) @map("history_id")

  reminderId Int @map("reminder_id")

  historyType HistoryType

  status HistoryStatus

  provider String? @db.VarChar(50)

  sentAt DateTime? @map("sent_at")

  attempt Int @default(0)

  errorMessage String?  @map("error_message") @db.Text
  reminder     Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("reminder_history")
}

enum HistoryType {
  PUSH
  VOICE_CALL
}

enum HistoryStatus {
  SUCCESS
  FAILED
  PENDING
}

model PushNotificationSetting {
  pushId Int @id @default(autoincrement()) @map("push_id")

  reminderId Int @map("reminder_id")

  minutesBefore Int @map("minutes_before")

  jobId String @map("job_id") @db.VarChar(100)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("push_notification_settings")
}

model VoiceCallSetting {
  callId Int @id @default(autoincrement()) @map("call_id")

  reminderId Int @map("reminder_id")

  minutesBefore Int @map("minutes_before")

  retryCount Int @default(0) @map("retry_count")

  jobId String? @map("job_id") @db.VarChar(100)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId], onDelete: Cascade)

  @@map("voice_call_settings")
}

model SilentHour {
  silentHourId Int @id @default(autoincrement()) @map("silent_hour_id")

  userId Int @map("user_id")

  dayOfWeek DayOfWeek @map("day_of_week")

  silentStart DateTime @map("silent_start") @db.Time

  silentEnd DateTime @map("silent_end") @db.Time

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("silent_hours")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
